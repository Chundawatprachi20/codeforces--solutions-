#include <bits/stdc++.h>
using namespace std;

using ll = long long;
using ull = unsigned long long;

/*
    Summary of a sequence:

    s = total sum
    p = maximum prefix sum
    q = maximum suffix sum
    m = maximum subarray sum
*/

struct Sum {
    ll s = 0;
    ll p = 0;
    ll q = 0;
    ll m = 0;
    bool empty = true;
};

Sum singleSum(ll x) {
    return {x, x, x, x, false};
}

Sum mergeSum(const Sum &a, const Sum &b) {
    if (a.empty) return b;
    if (b.empty) return a;

    Sum c;
    c.empty = false;

    c.s = a.s + b.s;
    c.p = max(a.p, a.s + b.p);
    c.q = max(b.q, b.s + a.q);
    c.m = max({a.m, b.m, a.q + b.p});

    return c;
}

/*
    Multiply every value in the sequence by k.

    Here k >= 0, so all four maximum-subarray
    values can simply be multiplied by k.
*/
Sum scaleSum(const Sum &a, ll k) {
    if (a.empty) return a;

    return {
        a.s * k,
        a.p * k,
        a.q * k,
        a.m * k,
        false
    };
}

/*
    Historical lazy tag.

    Before the first assignment, a value can only
    be x or -x.

    State:
        0 -> initial value >= 0
        1 -> initial value < 0

    pre[state] stores the coefficient history.

    sign[state] stores the final sign if there has
    been no assignment.

    If an assignment occurs:
        pre = history before first assignment
        suf = fixed history after assignment
        finalVal = final actual value
*/

struct Tag {
    bool active = false;
    bool hasAssign = false;

    Sum pre[2];

    int sign[2] = {1, -1};

    Sum suf;

    ll finalVal = 0;
};

inline int stateId(ll x) {
    return (x >= 0 ? 0 : 1);
}

/* ---------- Atomic Tags ---------- */

Tag makeNeg() {
    Tag t;
    t.active = true;

    t.sign[0] = -1;
    t.sign[1] = 1;

    return t;
}

Tag makeAssign(ll x) {
    Tag t;
    t.active = true;
    t.hasAssign = true;
    t.finalVal = x;

    return t;
}

Tag makeRecord() {
    Tag t;
    t.active = true;

    // If current value is +|x|, record coefficient +1.
    t.pre[0] = singleSum(1);

    // If current value is -|x|, record coefficient -1.
    t.pre[1] = singleSum(-1);

    return t;
}

/*
    Compose two tags:

        A followed by B

    Result represents:

        A -> B
*/

Tag composeTag(const Tag &A, const Tag &B) {
    if (!A.active) return B;
    if (!B.active) return A;

    Tag C;
    C.active = true;

    /* Case 1: neither has assignment */

    if (!A.hasAssign && !B.hasAssign) {
        for (int s = 0; s < 2; s++) {
            int nextState =
                (A.sign[s] >= 0 ? 0 : 1);

            C.pre[s] =
                mergeSum(A.pre[s],
                         B.pre[nextState]);

            C.sign[s] =
                B.sign[nextState];
        }

        return C;
    }

    C.hasAssign = true;

    /*
        Case 2:
        A has no assignment,
        B has assignment.

        The first assignment of B becomes the
        first assignment of the combined tag.
    */

    if (!A.hasAssign && B.hasAssign) {
        for (int s = 0; s < 2; s++) {
            int nextState =
                (A.sign[s] >= 0 ? 0 : 1);

            C.pre[s] =
                mergeSum(A.pre[s],
                         B.pre[nextState]);

            C.sign[s] = A.sign[s];
        }

        C.suf = B.suf;
        C.finalVal = B.finalVal;

        return C;
    }

    /*
        Case 3 / 4:
        A already contains an assignment.

        Therefore the value after A is fixed.
    */

    C.pre[0] = A.pre[0];
    C.pre[1] = A.pre[1];

    ll value = A.finalVal;
    ll absoluteValue = llabs(value);

    int s = stateId(value);

    if (!B.hasAssign) {
        C.suf =
            mergeSum(
                A.suf,
                scaleSum(B.pre[s],
                         absoluteValue)
            );

        C.finalVal =
            1LL * B.sign[s] *
            absoluteValue;
    }
    else {
        C.suf =
            mergeSum(
                mergeSum(
                    A.suf,
                    scaleSum(
                        B.pre[s],
                        absoluteValue
                    )
                ),
                B.suf
            );

        C.finalVal = B.finalVal;
    }

    return C;
}

/*
    Evaluate the history generated by tag T
    starting from actual value x.
*/

Sum evaluateHistory(const Tag &T, ll x) {
    if (!T.active) {
        return {};
    }

    int s = stateId(x);

    Sum result =
        scaleSum(
            T.pre[s],
            llabs(x)
        );

    if (T.hasAssign) {
        result =
            mergeSum(result, T.suf);
    }

    return result;
}

/* ============================================================
                        SEGMENT TREE
   ============================================================ */

struct SegTree {

    int n;

    vector<ll> mn;
    vector<ll> mx;

    /*
        base[p] is only meaningful for leaves.

        It stores the value at the last time
        this leaf's history was materialized.
    */

    vector<ll> base;

    /*
        Already materialized history:

        hSuf = maximum suffix
        hBest = maximum subarray
    */

    vector<ll> hSuf;
    vector<ll> hBest;

    vector<char> hasHist;

    vector<Tag> lazy;

    vector<ll> arr;

    SegTree(const vector<ll> &a) {

        n = (int)a.size() - 1;

        arr = a;

        int N = 4 * n + 5;

        mn.resize(N);
        mx.resize(N);

        base.resize(N);

        hSuf.assign(N, 0);
        hBest.assign(N, 0);

        hasHist.assign(N, 0);

        lazy.resize(N);

        build(1, 1, n);
    }

    void build(int p, int l, int r) {

        if (l == r) {
            mn[p] = mx[p] = base[p] = arr[l];
            return;
        }

        int mid = (l + r) / 2;

        build(p * 2, l, mid);
        build(p * 2 + 1, mid + 1, r);

        pull(p);
    }

    void pull(int p) {
        mn[p] =
            min(mn[p * 2],
                mn[p * 2 + 1]);

        mx[p] =
            max(mx[p * 2],
                mx[p * 2 + 1]);
    }

    /*
        Apply a historical tag to this node.

        We also update mn/mx according to the
        final transformation.
    */

    void applyTag(int p, const Tag &t) {

        if (!t.active) return;

        lazy[p] =
            composeTag(lazy[p], t);

        if (t.hasAssign) {

            mn[p] = mx[p] = t.finalVal;
        }
        else if (t.sign[0] == -1) {

            ll oldMn = mn[p];
            ll oldMx = mx[p];

            mn[p] = -oldMx;
            mx[p] = -oldMn;
        }
    }

    void push(int p) {

        if (!lazy[p].active) return;

        applyTag(p * 2, lazy[p]);
        applyTag(p * 2 + 1, lazy[p]);

        lazy[p] = Tag();
    }

    /* ---------------- Range Update ---------------- */

    void rangeApply(
        int p,
        int l,
        int r,
        int ql,
        int qr,
        const Tag &t
    ) {

        if (ql <= l && r <= qr) {
            applyTag(p, t);
            return;
        }

        push(p);

        int mid = (l + r) / 2;

        if (ql <= mid) {
            rangeApply(
                p * 2,
                l,
                mid,
                ql,
                qr,
                t
            );
        }

        if (qr > mid) {
            rangeApply(
                p * 2 + 1,
                mid + 1,
                r,
                ql,
                qr,
                t
            );
        }

        pull(p);
    }

    void assignRange(
        int l,
        int r,
        ll x
    ) {

        rangeApply(
            1,
            1,
            n,
            l,
            r,
            makeAssign(x)
        );
    }

    void negRange(
        int l,
        int r
    ) {

        rangeApply(
            1,
            1,
            n,
            l,
            r,
            makeNeg()
        );
    }

    /*
        Operation 3:

            a[i] = max(a[i], 0)

        If mn >= 0:
            nothing changes

        If mx <= 0:
            everything becomes 0

        Otherwise:
            recurse
    */

    void clampRec(
        int p,
        int l,
        int r,
        int ql,
        int qr
    ) {

        if (qr < l || r < ql) {
            return;
        }

        if (mn[p] >= 0) {
            return;
        }

        if (
            ql <= l &&
            r <= qr &&
            mx[p] <= 0
        ) {

            applyTag(
                p,
                makeAssign(0)
            );

            return;
        }

        if (l == r) {
            return;
        }

        push(p);

        int mid = (l + r) / 2;

        clampRec(
            p * 2,
            l,
            mid,
            ql,
            qr
        );

        clampRec(
            p * 2 + 1,
            mid + 1,
            r,
            ql,
            qr
        );

        pull(p);
    }

    void clampRange(
        int l,
        int r
    ) {

        clampRec(
            1,
            1,
            n,
            l,
            r
        );
    }

    /*
        Record the current value.

        This creates one new version.

        It is applied to the whole tree.
    */

    void record() {
        applyTag(
            1,
            makeRecord()
        );
    }

    /* ---------------- Point Query ---------------- */

    ll queryRec(
        int p,
        int l,
        int r,
        int pos
    ) {

        if (l == r) {

            /*
                Materialize all pending history
                for this position.
            */

            Sum add =
                evaluateHistory(
                    lazy[p],
                    base[p]
                );

            if (!add.empty) {

                if (!hasHist[p]) {

                    hSuf[p] = add.q;
                    hBest[p] = add.m;

                    hasHist[p] = 1;
                }
                else {

                    hBest[p] =
                        max({
                            hBest[p],
                            add.m,
                            hSuf[p] + add.p
                        });

                    hSuf[p] =
                        max(
                            add.q,
                            hSuf[p] + add.s
                        );
                }
            }

            /*
                History is now materialized.
            */

            lazy[p] = Tag();

            /*
                New base value is current value.
            */

            base[p] = mn[p];

            return hBest[p];
        }

        push(p);

        int mid = (l + r) / 2;

        if (pos <= mid) {

            return queryRec(
                p * 2,
                l,
                mid,
                pos
            );
        }

        return queryRec(
            p * 2 + 1,
            mid + 1,
            r,
            pos
        );
    }

    ll query(int pos) {
        return queryRec(
            1,
            1,
            n,
            pos
        );
    }
};

/* ============================================================
                            MAIN
   ============================================================ */

int main() {

    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {

        int n, q;

        cin >> n >> q;

        vector<ll> a(n + 1);

        for (int i = 1; i <= n; i++) {
            cin >> a[i];
        }

        SegTree st(a);

        ull lastans = 0;

        /*
            Version 0 must be recorded initially.
        */

        st.record();

        auto decode = [&](ull y) -> int {

            return (int)(
                ((y ^ lastans) %
                 (ull)n) + 1
            );
        };

        for (int i = 1; i <= q; i++) {

            int type;

            cin >> type;

            /* ------------ Type 1 ------------ */

            if (type == 1) {

                ull u, v;
                ll x;

                cin >> u >> v >> x;

                int l = decode(u);
                int r = decode(v);

                if (l > r) {
                    swap(l, r);
                }

                st.assignRange(
                    l,
                    r,
                    x
                );

                /*
                    Record version i.
                */

                st.record();
            }

            /* ------------ Type 2 ------------ */

            else if (type == 2) {

                ull u, v;

                cin >> u >> v;

                int l = decode(u);
                int r = decode(v);

                if (l > r) {
                    swap(l, r);
                }

                st.negRange(l, r);

                /*
                    Record version i.
                */

                st.record();
            }

            /* ------------ Type 3 ------------ */

            else if (type == 3) {

                ull u, v;

                cin >> u >> v;

                int l = decode(u);
                int r = decode(v);

                if (l > r) {
                    swap(l, r);
                }

                st.clampRange(l, r);

                /*
                    Record version i.
                */

                st.record();
            }

            /* ------------ Type 4 ------------ */

            else {

                ull u;

                cin >> u;

                int p = decode(u);

                /*
                    Query versions 0 ... i-1.
                */

                ll answer =
                    st.query(p);

                cout
                    << answer
                    << '\n';

                /*
                    Convert answer to modulo 2^64.

                    Casting signed long long to
                    unsigned long long does exactly this.
                */

                lastans =
                    (ull)answer;

                /*
                    Version i is identical to i-1,
                    so record it AFTER answering.
                */

                st.record();
            }
        }
    }

    return 0;
}
